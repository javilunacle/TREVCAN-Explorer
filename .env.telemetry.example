# Copy this file to .env.telemetry on the telemetry Pi and replace every value.
# Quote values that contain spaces or shell-special characters.
TELEMETRY_TOKEN='replace-with-the-shared-pi3-pi4-token'
TELEMETRY_CAR_HOST='192.168.0.145'
TELEMETRY_CAR_USER='trevor'
INFLUXDB_TOKEN='replace-with-a-long-random-influx-operator-token'
INFLUXDB_ADMIN_USERNAME='admin'
INFLUXDB_ADMIN_PASSWORD='replace-with-a-strong-influx-password'
GRAFANA_ADMIN_USERNAME='admin'
GRAFANA_ADMIN_PASSWORD='replace-with-a-strong-grafana-password'
GRAFANA_BIND_ADDRESS='0.0.0.0'
# Create a Grafana service account with Admin role, then generate its token.
# This is a publisher credential, separate from the transport/Influx tokens.
GRAFANA_LIVE_TOKEN='replace-with-a-grafana-service-account-token'
GRAFANA_LIVE_URL='http://127.0.0.1:3000/api/live/push/trevcan'

# Both Pis use small RAM buffers and discard disconnected data. No SQLite spool.
# InfluxDB retains successfully recorded history for 24 hours.

