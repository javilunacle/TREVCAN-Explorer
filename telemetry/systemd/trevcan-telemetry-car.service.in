[Unit]
Description=TREVCAN car CANManager telemetry sender
StartLimitIntervalSec=0

[Service]
Type=simple
UMask=0077
WorkingDirectory=%h/.local/share/trevcan
EnvironmentFile=%h/.config/trevcan/car.env
# CANManager in the dashboard owns SocketCAN; this process receives its output.
ExecStart=__PYTHON__ -m telemetry.car --canmanager-socket --host ${TELEMETRY_SERVER_HOST} --port ${TELEMETRY_SERVER_PORT}
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=default.target
